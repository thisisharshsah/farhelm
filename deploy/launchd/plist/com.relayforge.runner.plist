<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.farhelm.runner</string>
	<key>ProcessType</key>
	<string>Background</string>
	<!-- launchd starts a job with a minimal PATH, so an agent installed under
	     a user prefix (~/.local/bin, Homebrew) is invisible to it and the
	     runner reports "no agents installed" on a machine that has them. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>HOME_DIR/.local/bin:HOME_DIR/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>set -a; . /Users/harshsah/.farhelm/runner.env; set +a; exec /Users/harshsah/.farhelm/bin/farhelm serve --port 7852 --db /Users/harshsah/.farhelm/runner.db --key /Users/harshsah/.farhelm/runner.key --terminal pty</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/harshsah/.farhelm/logs/runner.log</string>
	<key>StandardOutPath</key>
	<string>/Users/harshsah/.farhelm/logs/runner.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/Users/harshsah/.farhelm</string>
</dict>
</plist>
