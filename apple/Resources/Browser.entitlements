<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Passkeys kept on this Mac (iCloud Keychain, Touch ID) for any site,
	     as browsers have them. Apple grants this on request; it only works
	     with the provisioning profile that carries it (see build.sh). -->
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
