{
  "manifest_version": 3,
  "name": "Companion",
  "version": "1.0.0",
  "description": "Lets the Companion app on this Mac read and work in your Chrome tabs when you ask it to.",
  "key": "",
  "permissions": ["tabs", "scripting", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Companion" }
}
