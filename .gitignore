/target
node_modules/
*.db
*.db-wal
*.db-shm
.DS_Store

# Secrets — never commit.
#
# forge.key is the runner's long-lived Ed25519 identity (farhelm-crypto's
# keystore writes it 0600). Every paired device trusts that public key, so
# leaking it lets an attacker impersonate the runner to the whole fleet, and
# losing it unpairs every device. vapid.key is the relay's Web Push signing
# key with the same "regenerating it breaks every subscription" property.
*.key
*.pem
farhelm.credential.json
.env
.env.*
!.env.example

# Built clients
web/dist/
# Staging for deploy/live-web.sh's swap.
web/.dist-next/
web/.dist-old/
# Installer downloads the web app serves (`/dl/<target>/farhelm`): built
# binaries, never source.
web/public/dl/
*.tsbuildinfo

# Swift Package Manager
.build/

# Expo prebuild output — generated from app.config.ts, never hand-edited.
# The watch target's *sources* live in mobile/watch and are checked in; the
# Xcode project that hosts them is not.
mobile/ios/
mobile/android/
.expo/
