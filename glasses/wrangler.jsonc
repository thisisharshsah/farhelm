// Lens on Cloudflare Workers: the API in worker/, the console (/) and the
// glasses app (/glasses) as static assets, data in D1. Secrets are not here:
// see README.md ("Release") and scripts/release.mjs.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lens",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Only the custom domain serves Lens: no workers.dev or preview hosts, so
	// the only host names a request can carry are lens.aurovie.com (and
	// localhost in development).
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "lens.aurovie.com",
			"custom_domain": true
		}
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"vars": {
		"RP_ID": "lens.aurovie.com",
		"RP_NAME": "Lens"
	},
	// Created on first deploy if it does not exist (scripts/deploy.mjs also
	// creates it before applying migrations).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lens",
			"database_id": "5cb7a802-a49e-4ce8-8fa4-83731a2178f8",
			"migrations_dir": "migrations"
		}
	],
	// Approximate, per Cloudflare location. Namespace IDs must be unique in the account.
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "70421",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "API_LIMITER",
			"namespace_id": "70422",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	// Daily housekeeping (worker/index.ts: cleanup).
	"triggers": {
		"crons": [
			"23 4 * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}